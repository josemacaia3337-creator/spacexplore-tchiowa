NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Preferred public key for new deployments:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Backward compatibility for existing Vercel environments; either key name is accepted.
# Do not use a service_role or sb_secret key in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key

# Public application origin used for Supabase email confirmation and password recovery.
# Set this to the exact production origin in Vercel (without a trailing slash).
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
